---
interface Props {
  size?: number;
  class?: string;
  animated?: boolean;
}

const { size = 28, animated = false } = Astro.props;
const draw = animated
  ? { strokeDasharray: 300, strokeDashoffset: 300, animation: 'gitmd-draw 1.6s cubic-bezier(0.6, 0, 0.2, 1) forwards' }
  : undefined;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  class={Astro.props.class}
  role="img"
  aria-label="GitMD"
>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round" style={draw}>
    <path d="M23.2 9.5V54.5" stroke="#3FB950" stroke-width="5.4" />
    <path d="M23.2 23.9C50.2 23.9 50.2 41.9 23.2 41.9" stroke="#58A6FF" stroke-width="5.4" />
  </g>
  <circle cx="23.2" cy="9.5" r="5.4" fill="#7EE787" />
  <circle cx="23.2" cy="23.9" r="5.4" fill="#7EE787" />
  <circle cx="23.2" cy="41.9" r="5.4" fill="#7EE787" />
  <circle cx="23.2" cy="54.5" r="5.4" fill="#7EE787" />
</svg>
