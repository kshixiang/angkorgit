{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "paths": {
      "@gitmd/core": ["./packages/core/src/index.ts"],
      "@gitmd/core/*": ["./packages/core/src/*"],
      "@gitmd/design-system": ["./packages/design-system/src/index.ts"],
      "@gitmd/design-system/*": ["./packages/design-system/src/*"]
    },
    "baseUrl": "."
  }
}
